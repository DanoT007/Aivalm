---
// Jednoduchý diagram toku: kroky za sebou, spojnica sa pri zobrazení „prebehne“.
interface Step { title: string; text?: string }
interface Props { steps: Step[]; label: string }
const { steps, label } = Astro.props;
---
<ol class="flow" aria-label={label} style={`--n:${steps.length}`}>
  {steps.map((s, i) => (
    <li style={`--i:${i}`}>
      <span class="dot" aria-hidden="true"><span>{i + 1}</span></span>
      <div class="body">
        <h3>{s.title}</h3>
        {s.text && <p>{s.text}</p>}
      </div>
    </li>
  ))}
</ol>

<script>
  const io = 'IntersectionObserver' in window
    ? new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('run'); io?.unobserve(e.target); }
      }, { threshold: 0.3 })
    : null;
  document.querySelectorAll('.flow').forEach((el) => (io ? io.observe(el) : el.classList.add('run')));
</script>

<style>
  .flow { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 0; position: relative; counter-reset: s; }
  .flow::before { content: ''; position: absolute; top: 22px; left: 22px; right: 22px; height: 1px; background: var(--line-dark); }
  .flow::after { content: ''; position: absolute; top: 22px; left: 22px; height: 1px; width: calc(100% - 44px); background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform 1.6s cubic-bezier(.6,0,.2,1); }
  :global(.flow.run)::after { transform: scaleX(1); }
  :global(.band-light) .flow::before { background: var(--line-light); }
  .flow li { position: relative; display: grid; gap: 18px; padding-right: 20px; align-content: start; }
  .dot { width: 44px; height: 44px; border-radius: 50%; border: 1px solid currentColor; display: grid; place-items: center; font-size: 0.85rem; font-weight: 600; background: var(--ink); position: relative; z-index: 1; font-variant-numeric: tabular-nums; transition: background .3s, color .3s; transition-delay: calc(var(--i) * 0.3s + .2s); }
  :global(.band-light) .dot { background: var(--paper); }
  :global(.band-raised) .dot { background: var(--ink-2); }
  :global(.flow.run) .dot { background: var(--on-dark); color: var(--ink); }
  :global(.band-light .flow.run) .dot { background: var(--on-light); color: var(--paper); }
  .body { display: grid; gap: 6px; align-content: start; }
  .body h3 { font-size: 1.05rem; }
  .body p { font-size: 0.95rem; color: var(--on-dark-muted); }
  :global(.band-light) .body p { color: var(--on-light-muted); }

  @media (max-width: 860px) {
    .flow { grid-template-columns: 1fr; gap: 28px; }
    .flow::before { top: 22px; bottom: 22px; left: 22px; right: auto; width: 1px; height: auto; }
    .flow::after { top: 22px; left: 22px; width: 1px; height: calc(100% - 44px); transform: scaleY(0); transform-origin: top; }
    :global(.flow.run)::after { transform: scaleY(1); }
    .flow li { grid-template-columns: 44px 1fr; gap: 18px; padding-right: 0; }
  }
</style>
