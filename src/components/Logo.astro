---
import { LOGO_PATH } from '../config';

interface Props {
  id: string;
  size?: number;
}
const { id, size = 34 } = Astro.props;
const clip = `logo-clip-${id}`;
---
<a href="/" class="logo" aria-label="AIVALM – domov">
  <svg class="logo-mark" viewBox="0 0 2000 2051" width={size} height={size * 1.0255} aria-hidden="true">
    <defs>
      <clipPath id={clip}><path fill-rule="evenodd" clip-rule="evenodd" d={LOGO_PATH} /></clipPath>
    </defs>
    <g clip-path={`url(#${clip})`}>
      <rect width="2000" height="2051" fill="currentColor" />
      <rect class="logo-shine" x="-900" y="-200" width="420" height="2500" fill="var(--ink)" opacity="0.55" transform="rotate(18 1000 1025)" />
    </g>
  </svg>
  <span class="logo-word">AIVALM</span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; color: inherit; }
  .logo-mark { display: block; transition: transform .45s cubic-bezier(.2,.8,.2,1); transform-origin: 50% 90%; }
  .logo-word { font-weight: 700; font-size: 1.05rem; letter-spacing: 0.22em; transition: letter-spacing .45s cubic-bezier(.2,.8,.2,1); }
  .logo-shine { transition: none; }
  .logo:hover .logo-mark, .logo:focus-visible .logo-mark { transform: translateY(-2px) scale(1.08); }
  .logo:hover .logo-word, .logo:focus-visible .logo-word { letter-spacing: 0.3em; }
  .logo:hover .logo-shine, .logo:focus-visible .logo-shine { animation: shine .9s cubic-bezier(.4,0,.2,1) forwards; }
  @keyframes shine { from { transform: rotate(18deg) translateX(0); } to { transform: rotate(18deg) translateX(3200px); } }
</style>
