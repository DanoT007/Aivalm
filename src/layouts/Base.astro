---
import '@fontsource-variable/montserrat';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { CONTACT_EMAIL, CONTACT_PHONE } from '../config';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const fullTitle = title === 'AIVALM' ? 'AIVALM – AI automatizácie, aby žiadny dopyt nevychladol' : `${title} | AIVALM`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const products = [
  { href: '/hlasovy-agent', label: 'AI hlasový agent' },
  { href: '/odhad-ceny', label: 'AI odhad ceny / výkup' },
  { href: '/odpovede-na-dopyty', label: 'AI odpovede na dopyty' },
];
const nav = [
  { href: '/ako-spolupracujeme', label: 'Spolupráca' },
  { href: '/bezpecnost', label: 'Bezpečnosť' },
  { href: '/o-nas', label: 'O nás' },
];
const isActive = (href: string) => path === href;
---
<!doctype html>
<html lang="sk">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="sk_SK" />
  <meta name="theme-color" content="#0c0d0f" />
</head>
<body>
  <a class="skip sr-only" href="#obsah">Preskočiť na obsah</a>
  <header class="site-header">
    <div class="wrap header-row">
      <Logo id="head" />
      <nav aria-label="Hlavná navigácia">
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu">
          <span class="sr-only">Menu</span><span class="bars" aria-hidden="true"></span>
        </button>
        <ul id="menu" class="menu">
          <li class="has-sub">
            <span class="menu-label">Produkty</span>
            <ul class="sub">
              {products.map((p) => <li><a href={p.href} aria-current={isActive(p.href) ? 'page' : undefined}>{p.label}</a></li>)}
            </ul>
          </li>
          {nav.map((n) => <li><a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
          <li><a class="btn btn-primary menu-cta" href="/kontakt">Dohodnúť konzultáciu</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="obsah">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div class="stack">
        <Logo id="foot" size={30} />
        <p class="muted">Slovenská AI agentúra. Staviame AI hlasových agentov a automatické odpovede na dopyty, aby firmy reagovali do minút, nie do dní.</p>
      </div>
      <div class="stack-sm">
        <span class="eyebrow">Produkty</span>
        {products.map((p) => <a href={p.href}>{p.label}</a>)}
      </div>
      <div class="stack-sm">
        <span class="eyebrow">AIVALM</span>
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href="/kontakt">Kontakt</a>
      </div>
      <div class="stack-sm">
        <span class="eyebrow">Kontakt</span>
        {CONTACT_EMAIL ? <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> : <span class="todo">DOPLNIŤ: e-mail</span>}
        {CONTACT_PHONE ? <a href={`tel:${CONTACT_PHONE.replace(/\s/g, '')}`}>{CONTACT_PHONE}</a> : <span class="todo">DOPLNIŤ: telefón</span>}
      </div>
    </div>
    <div class="wrap footer-bottom">
      <span>© {new Date().getFullYear()} AIVALM</span>
      <span class="footer-legal">
        <a href="/ochrana-osobnych-udajov">Ochrana osobných údajov</a>
        <a href="/cookies">Cookies</a>
      </span>
    </div>
  </footer>

  <script>
    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const menu = document.getElementById('menu');
    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      menu?.classList.toggle('open', !open);
    });
  </script>
</body>
</html>

<style>
  .skip:focus { position: fixed; top: 12px; left: 12px; width: auto; height: auto; clip: auto; padding: 10px 14px; background: var(--on-dark); color: var(--ink); z-index: 100; }
  .site-header { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--ink) 92%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line-dark); padding-top: env(safe-area-inset-top, 0px); }
  .header-row { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 76px; }
  .menu { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 28px; }
  .menu a { text-decoration: none; font-size: 0.92rem; font-weight: 500; }
  .menu > li > a:not(.btn), .menu-label { color: var(--on-dark-muted); transition: color .2s; }
  .menu > li > a:not(.btn):hover, .menu a[aria-current='page'], .has-sub:hover .menu-label { color: var(--on-dark); }
  .menu-label { font-size: 0.92rem; font-weight: 500; cursor: default; }
  .menu-cta { padding: 11px 18px; }
  .has-sub { position: relative; }
  .sub { list-style: none; margin: 0; padding: 10px; position: absolute; top: 100%; left: -14px; min-width: 250px; background: var(--ink-2); border: 1px solid var(--line-dark); border-radius: var(--radius); display: grid; gap: 2px; opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity .2s, transform .2s, visibility .2s; }
  .has-sub::after { content: ''; position: absolute; top: 100%; left: 0; right: 0; height: 12px; }
  .has-sub:hover .sub, .has-sub:focus-within .sub { opacity: 1; visibility: visible; transform: none; }
  .sub a { display: block; padding: 9px 12px; border-radius: var(--radius); }
  .sub a:hover, .sub a[aria-current='page'] { background: var(--ink-3); }
  .menu-toggle { display: none; background: none; border: 0; color: inherit; width: 44px; height: 44px; cursor: pointer; }
  .bars, .bars::before, .bars::after { display: block; width: 22px; height: 2px; background: currentColor; position: relative; margin: 0 auto; }
  .bars::before, .bars::after { content: ''; position: absolute; left: 0; }
  .bars::before { top: -7px; } .bars::after { top: 7px; }

  @media (max-width: 920px) {
    .menu-toggle { display: block; }
    .menu { display: none; position: absolute; left: 0; right: 0; top: 100%; flex-direction: column; align-items: stretch; gap: 0; padding: 12px var(--gutter) 24px; background: var(--ink); border-bottom: 1px solid var(--line-dark); }
    .menu.open { display: flex; }
    .menu > li { border-bottom: 1px solid var(--line-dark); }
    .menu > li > a:not(.btn), .menu-label { display: block; padding: 14px 0; font-size: 1rem; }
    .sub { position: static; opacity: 1; visibility: visible; transform: none; background: none; border: 0; padding: 0 0 10px 12px; min-width: 0; }
    .menu > li:last-child { border: 0; padding-top: 16px; }
    .menu-cta { width: 100%; justify-content: center; }
  }

  .site-footer { border-top: 1px solid var(--line-dark); padding-block: 64px 32px; font-size: 0.95rem; }
  .footer-grid { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: 40px; }
  .footer-grid > * { min-width: 0; }
  @media (max-width: 820px) { .footer-grid { grid-template-columns: 1fr 1fr; } .footer-grid > :first-child { grid-column: 1 / -1; } }
  @media (max-width: 460px) { .footer-grid { grid-template-columns: 1fr; } }
  .stack-sm { display: grid; gap: 10px; align-content: start; }
  .stack-sm a { text-decoration: none; color: var(--on-dark-muted); }
  .stack-sm a:hover { color: var(--on-dark); }
  .footer-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--line-dark); color: var(--on-dark-muted); font-size: 0.85rem; }
  .footer-legal { display: flex; gap: 20px; flex-wrap: wrap; }
  .footer-legal a { text-decoration: none; }
  .footer-legal a:hover { color: var(--on-dark); }
</style>
